# Demo local mặc định dùng SQLite. Bỏ dấu # và thay URL để dùng Neon.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# AI phía backend. Không đặt khóa trong frontend hoặc commit file .env.
AI_PROVIDER=google
GOOGLE_AI_API_KEY=
GOOGLE_AI_MODEL=gemini-3.6-flash
GOOGLE_AI_FALLBACK_MODEL=gemini-3.1-flash-lite

# Tùy chọn nếu muốn đổi sang OpenAI: đặt AI_PROVIDER=openai.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_VISION_MODEL=gpt-5-mini

APP_ENV=development
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Mở đúng địa chỉ này để cookie Google OAuth khớp callback.
APP_BASE_URL=http://localhost:8000
# Google Cloud -> OAuth Client (Web application).
# Authorized redirect URI: http://localhost:8000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Tạo bằng: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=
# Mặc định chỉ dùng thử được trên chính máy chạy server (localhost, development).
ENABLE_DEMO_LOGIN=true
# Đặt true để ai có đường link cũng tạo được tài khoản dùng thử (ví dụ cho giám khảo).
# Khi bật, cả hệ thống chỉ tạo tối đa DEMO_ACCOUNTS_PER_HOUR tài khoản dùng thử mỗi giờ.
# Tài khoản dùng thử cũ hơn DEMO_RETENTION_DAYS ngày sẽ tự bị xóa cùng dữ liệu của nó (chỉ khi DEMO_PUBLIC=true).
DEMO_PUBLIC=false
DEMO_ACCOUNTS_PER_HOUR=10
DEMO_RETENTION_DAYS=3
