{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "genesense",
      "runtimeExecutable": ".venv/Scripts/python.exe",
      "runtimeArgs": [
        "-m",
        "uvicorn",
        "backend.app.main:app",
        "--reload",
        "--host",
        "127.0.0.1",
        "--port",
        "8000"
      ],
      "port": 8000,
      "url": "http://localhost:8000"
    },
    {
      "name": "genesense-public",
      "runtimeExecutable": ".venv/Scripts/python.exe",
      "runtimeArgs": [
        "-m",
        "uvicorn",
        "backend.app.main:app",
        "--env-file",
        ".env.public",
        "--host",
        "127.0.0.1",
        "--port",
        "8001"
      ],
      "port": 8001,
      "url": "http://localhost:8001"
    }
  ]
}
